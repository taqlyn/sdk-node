{
  "name": "@taqlyn/sdk-node",
  "version": "0.6.0",
  "description": "Taqlyn Node/TypeScript server SDK — Ed25519-signed ShortLink create",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "taqlyn",
    "deep-links",
    "short-links",
    "ed25519"
  ],
  "license": "MIT"
}
